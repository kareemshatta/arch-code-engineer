# ================================================
# Arch Code Engineer - Environment Variables
# ================================================
# Copy this file to .env and fill in your values
# Use: npm run env:dev   → switch to development (SQLite)
# Use: npm run env:prod  → switch to production  (PostgreSQL)
# ================================================

# ------ Database ------
# Development (SQLite - local file):
#   DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL / Neon):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
DATABASE_URL=

# ------ NextAuth ------
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ------ Admin Seed ------
ADMIN_EMAIL="admin@archcodeengineer.com"
ADMIN_PASSWORD="Admin@123456"

# ------ Optional: Analytics ------
# GOOGLE_ANALYTICS_ID=
# FACEBOOK_PIXEL_ID=
